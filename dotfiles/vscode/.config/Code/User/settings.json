{
  "extensions.autoUpdate": false,
  "update.mode": "manual",
  "workbench.colorTheme": "Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.sideBar.location": "right",
  "files.autoSave": "afterDelay",
  "gitlens.hovers.enabled": false,
  "gitlens.codeLens.recentChange.enabled": false,
  "gitlens.codeLens.enabled": false,
  "editor.unicodeHighlight.allowedLocales": {
    "zh-hant": true,
  },
  "cSpell.userWords": [
    "apifox",
    "autofetch",
    "BNINIDJA",
    "callerframerecord",
    "dateutil",
    "defajultdict",
    "dingtalk",
    "dspread",
    "duitku",
    "duitkui",
    "enddot",
    "Farman",
    "funcfilter",
    "funcs",
    "fxadapter",
    "gevent",
    "hashids",
    "hdel",
    "hget",
    "hgetall",
    "hset",
    "ICBC",
    "Inno",
    "ipdb",
    "isnot",
    "isort",
    "itertuples",
    "Jalen",
    "jsonify",
    "KGSMAP",
    "ksher",
    "lazada",
    "maybank",
    "mypy",
    "NEGARA",
    "onupdate",
    "Openapi",
    "outerjoin",
    "pdfkit",
    "pkgs",
    "PUBLICKEY",
    "puml",
    "pydantic",
    "pymysql",
    "rabbitmq",
    "relativedelta",
    "sadd",
    "setex",
    "setnx",
    "SHOPEE",
    "smembers",
    "sqlalchemy",
    "startdot",
    "supervisorctl",
    "templating",
    "tiktok",
    "tmpl",
    "tongdun",
    "varchar",
    "venv",
    "werkzeug",
    "xlsxwriter",
    "Zlando",
  ],
  "editor.rulers": [88, 120],
  "editor.fontSize": 16,
  "editor.fontFamily": "'Maple Mono Normal', 'JetBrainsMono Nerd Font Mono', Consolas, 'Courier New', monospace",
  "vim.commandLineModeKeyBindings": [],
  // vim config
  "vim.useCtrlKeys": false,
  "vim.handleKeys": {
    "<C-c>": false,
    "<C-v>": false,
    "<C-d>": true,
    // "<C-o>": true,
    // "<C-i>": true
  },
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"],
    },
  ],
  "vim.normalModeKeyBindings": [
    {
      // prev buffer
      "before": ["H"],
      "commands": ["workbench.action.previousEditor"],
      "silent": true,
    },
    {
      // next buffer
      "before": ["L"],
      "commands": ["workbench.action.nextEditor"],
      "silent": true,
    },
    {
      // Go to Next Change
      "before": ["g", "j"],
      "commands": [
        "workbench.action.editor.nextChange",
        "workbench.action.compareEditor.nextChange",
      ],
      "silent": true,
    },
    {
      // Go to Previous Change
      "before": ["g", "k"],
      "commands": [
        "workbench.action.editor.previousChange",
        "workbench.action.compareEditor.previousChange",
      ],
      "silent": true,
    },
    {
      // showHover
      "before": ["g", "h"],
      "commands": ["editor.action.showHover"],
      "silent": true,
    },
    {
      // goToReferences
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"],
      "silent": true,
    },
    {
      // go back
      "before": ["g", "o"],
      "commands": ["editor.action.goToReferences"],
      "silent": true,
    },
  ],
  "editor.formatOnSave": true,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.lineNumbers": "relative",
  "tabnine.experimentalAutoImports": true,
  "workbench.tree.enableStickyScroll": true,
  "workbench.tree.indent": 16,
  // "workbench.tree.renderIndentGuides": "always",
  "workbench.colorCustomizations": {
    "tree.indentGuidesStroke": "#05e2d0",
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "markdown-preview-enhanced.previewTheme": "medium.css",
  "markdown.preview.fontSize": 16,
  "todo-tree.general.tags": ["jk"],
  "terminal.integrated.scrollback": 9999999999999,
  "outline.showVariables": false,
  "workbench.editor.enablePreview": false,
  "gitlens.views.searchAndCompare.files.layout": "list",
  "git.autofetch": true,
  "files.watcherExclude": {
    "**/.mypy_cache/*/**": true,
    "**/.venv/**": true,
  },
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "terminal.integrated.smoothScrolling": true,
  "[sql]": {
    "editor.defaultFormatter": "adpyke.vscode-sql-formatter",
  },
  "notebook.lineNumbers": "on",
  "editor.cursorBlinking": "smooth",
  "markdown-preview-enhanced.revealjsTheme": "moon.css",
  "markdown-preview-enhanced.codeBlockTheme": "vue.css",
  "extensions.autoCheckUpdates": false,
  "comments.visible": false,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.fontLigatures": true,
  "workbench.editorAssociations": {
    "{git,gitlens}:/**/*.{md,csv,svg}": "default",
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "github.copilot.nextEditSuggestions.enabled": true,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.inlineSuggest.edits.showCollapsed": true,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "oaicopilot.models": [
